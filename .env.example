# RenVer settings. Copy this file to `.env` (never commit `.env`) and change what you need.
# Every line is optional locally. On a server, set at least RENVER_MODE and RENVER_ADMIN_PASSWORD.
# Lines starting with # are off: remove the # (and the example value) to use them.
# Next.js reads `.env` by itself for `npm start` and `npm run dev`. On a server running under systemd, put
# these in /etc/renver.env instead (see scripts/renver.service). `npm run restore` does not read `.env`:
# pass RENVER_DATA_DIR on the command line if you use a custom data folder.

# --- Mode and login -------------------------------------------------------------------------------------------
# "local" (default) runs on your computer. "production" makes the panel refuse to start without a password
# and turns on HTTPS-only headers.
RENVER_MODE=local

# Password for the panel (any username works). REQUIRED when RENVER_MODE=production.
# Use a long random value, for example: openssl rand -base64 24
# RENVER_ADMIN_PASSWORD=change-me

# --- Domains --------------------------------------------------------------------------------------------------
# The first domain, added on first start. You add more on the Domains page. Locally this stays "localhost".
RENVER_BASE_DOMAIN=localhost

# Address the panel itself is served on through Caddy, for example panel.example.com.
# Locally it defaults to panel.localhost. In production it must be set, or the panel is not published on a name.
# RENVER_PANEL_HOST=panel.example.com

# --- Port -----------------------------------------------------------------------------------------------------
# The port the panel starts on. Default 3000. If it is taken, the next free port is used automatically.
# RENVER_PORT=3000

# --- Where data lives -----------------------------------------------------------------------------------------
# Database, encryption key, saved sources, logs and backups. Back this folder up; never put it in git.
RENVER_DATA_DIR=./data

# Optional: the encryption key itself (base64, 32 bytes), instead of the generated data/secret.key file.
# If you set it, keep it safe: without it stored passwords and variables cannot be read. Leave empty to use the file.
# RENVER_SECRET=

# --- Protecting your data -------------------------------------------------------------------------------------
# Encrypts every new backup (AES-256) with this passphrase. Without it, anyone who gets a backup file gets your
# encryption key. Choose a long phrase and keep it somewhere OTHER than this server (a password manager): you
# need it to restore, and it cannot be recovered. Already-made backups stay as they are.
# RENVER_BACKUP_PASSPHRASE=

# Only these addresses may reach the panel at all (the machine itself always can). Comma or space separated;
# single addresses, ranges like 203.0.113.0/24, and IPv6 work. A mistake in the list locks everyone else out
# rather than opening the panel. Leave unset to allow everyone (the password still applies).
# RENVER_ALLOWED_IPS=203.0.113.7, 198.51.100.0/24

# --- Apps -----------------------------------------------------------------------------------------------------
# Starting memory and CPU limit for each app. You can change these in Settings, and per project under Runtime.
RENVER_APP_MEMORY=512m
RENVER_APP_CPUS=1

# The first local port given to an app. Each new app gets the next free one.
RENVER_HOST_PORT_START=4001
