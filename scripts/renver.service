# systemd unit for running RenVer on a Linux server so it starts at boot and restarts if it crashes.
#
#   sudo cp scripts/renver.service /etc/systemd/system/renver.service
#   sudo nano /etc/systemd/system/renver.service      # set User, WorkingDirectory and the Environment lines
#   sudo systemctl daemon-reload && sudo systemctl enable --now renver
#   journalctl -u renver -f                            # watch its output
#
# Run `npm ci && npm run build` in WorkingDirectory first. Caddy and Docker must also start at boot (they do after
# scripts/install.sh).

[Unit]
Description=RenVer panel
After=network-online.target docker.service
Wants=network-online.target
Wants=docker.service
# Never stop trying to restart (the default gives up after 5 quick failures, which looks like "sometimes not running").
StartLimitIntervalSec=0

[Service]
Type=simple
User=renver
WorkingDirectory=/opt/renver
Environment=NODE_ENV=production
Environment=RENVER_MODE=production
Environment=RENVER_BASE_DOMAIN=example.com
Environment=RENVER_PANEL_HOST=panel.example.com
# Do NOT put the password here. RenVer reads RENVER_ADMIN_PASSWORD and the other secrets from .env in WorkingDirectory
# (run `npm run setup` to write it). A value set here would silently override .env.
ExecStart=/usr/bin/node scripts/launcher.mjs start
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
